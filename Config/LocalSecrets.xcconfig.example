// Copy this file to LocalSecrets.xcconfig for local-only overrides.
// This file is ignored by git.

// Recommended: point app to your backend proxy.
GAMMAN_AI_PROXY_BASE_URL =
// Example: GAMMAN_AI_PROXY_BASE_URL = https:$(SLASH)$(SLASH)api.example.com

// Optional: client token expected by your proxy.
GAMMAN_AI_PROXY_CLIENT_TOKEN =

// Avoid shipping vendor keys in iOS apps.
// If needed for local debugging only, set them here:
// GAMMAN_CLAUDE_API_KEY = sk-ant-...
// GAMMAN_EXA_API_KEY = exa-...
// GAMMAN_OPENAI_API_KEY = sk-...
